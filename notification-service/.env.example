# Database URL for Drizzle ORM
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email credentials
EMAIL_FROM=cipd@iiitd.ac.in
EMAIL_PASSWORD=your-gmail-app-password

# Protects message management endpoints. Use a long random value.
NOTIFICATION_SERVICE_TOKEN=replace-with-a-long-random-token
CRON_SECRET=replace-with-cron-secret

# In testing, only these recipients receive feedback mail. Set to false in production.
NOTIFICATION_SANDBOX_MODE=true
NOTIFICATION_SANDBOX_RECIPIENTS=first.tester@example.com,second.tester@example.com

PORT=3100
NOTIFICATION_WORKER_INTERVAL_MS=30000
