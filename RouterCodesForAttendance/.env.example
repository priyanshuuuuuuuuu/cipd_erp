# RouterCodesForAttendance — Environment Variables
# Copy to .env and fill in real values. Do NOT commit .env.

# Supabase service role key (used by wifi_monitor.py to write attendance records)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: override which Supabase schema the monitor writes to
SUPABASE_SCHEMA=july
