# ─────────────────────────────────────────────────────────────────────────────
# CIPD ERP — Environment Variable Template
# Copy this file to .env.local (or .env) and fill in real values.
# This file is safe to commit — it contains NO real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (college VM PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgres://cipd_app:password@192.168.3.190:5432/cipd
# Used only by scripts/test-cohort-isolation.mjs and for testing migrations. Never point this at production.
STAGING_DATABASE_URL=

# ── Wi-Fi snapshots ONLY (Supabase) ───────────────────────────────────────────
# The Wi-Fi scanner runs on a separate network and writes public.wifi_snapshots to Supabase.
# These are SERVER-ONLY. Nothing else in the ERP uses Supabase. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── File storage (local disk on the VM) ───────────────────────────────────────
# Directory must exist and be writable by the PM2 user: sudo mkdir -p /var/lib/cipd/uploads && sudo chown <pm2-user> /var/lib/cipd/uploads
STORAGE_DIR=/var/lib/cipd/uploads
# Where scripts/cohort-delete.mjs writes pg_dump backups
BACKUP_DIR=/var/backups/cipd

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-chars-long

# ── Cron Job Protection ───────────────────────────────────────────────────────
# A random secret that protects the /api/cron/* endpoints from unauthorized calls
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── Email (Gmail SMTP via Nodemailer) ─────────────────────────────────────────
# Use a Gmail account with an App Password (not your regular password)
# Enable App Passwords: https://myaccount.google.com/apppasswords
EMAIL_FROM=cipd@iiitd.ac.in
EMAIL_PASSWORD=your-gmail-app-password

# ── Notification stream (safe testing) ──────────────────────────────────────
# true routes feedback email only to NOTIFICATION_SANDBOX_RECIPIENTS; real students are never emailed.
NOTIFICATION_SANDBOX_MODE=true
NOTIFICATION_SANDBOX_RECIPIENTS=first.tester@example.com,second.tester@example.com
NOTIFICATION_WORKER_INTERVAL_MS=30000

# Alert recipients for attendance worker failures (comma-separated)
ALERT_RECIPIENTS=admin@example.com,backup@example.com

# ── App Configuration ─────────────────────────────────────────────────────────
# Base URL where the Next.js app is running
APP_URL=http://localhost:3000

# ── Cohorts ───────────────────────────────────────────────────────────────────
# Cohorts live in the core.cohorts table (managed from Admin > Cohorts). Nothing to configure here.

# ── Google OAuth (optional — only if Google login is enabled) ─────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
