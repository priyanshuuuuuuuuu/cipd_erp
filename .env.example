# ─────────────────────────────────────────────────────────────────────────────
# CIPD ERP — Environment Variable Template
# Copy this file to .env.local (or .env) and fill in real values.
# This file is safe to commit — it contains NO real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-chars-long

# ── Cron Job Protection ───────────────────────────────────────────────────────
# A random secret that protects the /api/cron/* endpoints from unauthorized calls
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── Email (Gmail SMTP via Nodemailer) ─────────────────────────────────────────
# Use a Gmail account with an App Password (not your regular password)
# Enable App Passwords: https://myaccount.google.com/apppasswords
EMAIL_FROM=cipd@iiitd.ac.in
EMAIL_PASSWORD=your-gmail-app-password

# ── Notification stream (safe testing) ──────────────────────────────────────
# true routes feedback email only to NOTIFICATION_SANDBOX_RECIPIENTS; real students are never emailed.
NOTIFICATION_SANDBOX_MODE=true
NOTIFICATION_SANDBOX_RECIPIENTS=first.tester@example.com,second.tester@example.com
NOTIFICATION_WORKER_INTERVAL_MS=30000

# Alert recipients for attendance worker failures (comma-separated)
ALERT_RECIPIENTS=admin@example.com,backup@example.com

# ── App Configuration ─────────────────────────────────────────────────────────
# Base URL where the Next.js app is running
APP_URL=http://localhost:3000

# ── Cohort / Schema Configuration ────────────────────────────────────────────
# Comma-separated list of Supabase schemas (one per cohort/batch)
COHORT_SCHEMAS=july

# JSON map of schema -> display label
COHORT_LABELS={"july":"July 2025 Cohort"}

# ── Google OAuth (optional — only if Google login is enabled) ─────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
